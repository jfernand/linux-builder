build_dir = "build-distro"
networking = false

[kernel]
version = "6.17"
url = "https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.17.tar.xz"
features = ["graphics"]

[uutils]
git_url = "https://github.com/uutils/coreutils.git"
git_rev = "main"

[bash]
version = "5.2.37"
url = "https://ftp.gnu.org/gnu/bash/bash-5.2.37.tar.gz"

[util_linux]
version = "2.41.2"
url = "https://mirrors.edge.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-2.41.2.tar.xz"
# Off by default: only agetty/mount/umount are built (all Phase 1 needs).
# Set true to build and install the rest of util-linux's ~120 programs too
# (lsblk, fdisk, blkid, findmnt, swapon, wipefs, ...), statically.
# full = true

[shadow]
version = "4.17.4"
url = "https://github.com/shadow-maint/shadow/releases/download/4.17.4/shadow-4.17.4.tar.xz"

[seatd]
version = "0.9.3"
url = "https://git.sr.ht/~kennylevinsen/seatd/archive/0.9.3.tar.gz"

[dbus]
version = "1.16.2"
url = "https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz"

[eudev]
version = "3.2.14"
url = "https://github.com/eudev-project/eudev/releases/download/v3.2.14/eudev-3.2.14.tar.gz"

[wayland]
version = "1.26.0"
url = "https://gitlab.freedesktop.org/-/project/121/uploads/5f5d2e19a230e8b8250d9a7c2f280846/wayland-1.26.0.tar.xz"

[wayland_protocols]
version = "1.49"
url = "https://gitlab.freedesktop.org/-/project/2891/uploads/7ed597f0cad076a17fe36f8860596f8c/wayland-protocols-1.49.tar.xz"

[libxkbcommon]
version = "1.12.4"
url = "https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-1.12.4.tar.gz"

[pixman]
version = "0.46.4"
url = "https://gitlab.freedesktop.org/pixman/pixman/-/archive/pixman-0.46.4/pixman-pixman-0.46.4.tar.gz"

[libdisplay_info]
version = "0.3.0"
url = "https://gitlab.freedesktop.org/-/project/14497/uploads/a7e427e2c5ef474032a87459443b7982/libdisplay-info-0.3.0.tar.xz"

[libevdev]
version = "1.13.7"
url = "https://gitlab.freedesktop.org/libevdev/libevdev/-/archive/libevdev-1.13.7/libevdev-libevdev-1.13.7.tar.gz"

[libinput]
version = "1.31.3"
url = "https://gitlab.freedesktop.org/libinput/libinput/-/archive/1.31.3/libinput-1.31.3.tar.gz"

[libdrm]
version = "2.4.134"
url = "https://gitlab.freedesktop.org/mesa/drm/-/archive/libdrm-2.4.134/drm-libdrm-2.4.134.tar.gz"

[mesa]
version = "26.2.2"
url = "https://gitlab.freedesktop.org/mesa/mesa/-/archive/mesa-26.2.2/mesa-mesa-26.2.2.tar.gz"

[image]
arch = "x86_64"
size_mb = 2048
hostname = "distro"
